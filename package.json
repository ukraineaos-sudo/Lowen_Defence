{
  "name": "lowen-defence-ukraine",
  "private": true,
  "version": "1.0.0",
  "description": "package.json — залежності та npm-скрипти (dev/build/start, генерація credentials)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:credentials": "tsx scripts/generate-credentials.ts",
    "hash-password": "tsx scripts/generate-credentials.ts",
    "generate:secret": "tsx scripts/generate-credentials.ts --secret-only"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "lucide-react": "^0.546.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
